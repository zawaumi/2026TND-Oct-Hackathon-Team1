{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-no-mock.mjs out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
