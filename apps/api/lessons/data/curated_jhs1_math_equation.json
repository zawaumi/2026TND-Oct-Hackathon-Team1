    {
      "code": "equality-add-subtract",
      "title": "等式の両辺に同じ数をたす・ひく",
      "description": "等式の両辺に同じ数や式をたしても、ひいても、等式は成り立つ。たとえば x＋3＝7 の両辺から 3 をひくと x＝4 になる。",
      "difficulty": 1,
      "skills": [
        "add_both_sides",
        "subtract_both_sides"
      ],
      "prerequisites": [],
      "verification": "VERIFIED",
      "mastery_policy": {
        "required_correct": 1,
        "required_problem_variants": 1,
        "require_verified_steps": true
      },
      "examples": [
        {
          "id": "ex-add-sub-1",
          "form": "x+a=b",
          "equation": "x+3=7",
          "solution": "4",
          "purpose": "両辺から同じ数をひく（x＋3＝7）",
          "steps": [
            {
              "expr": "x+3=7"
            },
            {
              "expr": "x+3-3=7-3",
              "ops": [
                {
                  "rule": "subtract_both_sides",
                  "arg": "3"
                }
              ]
            },
            {
              "expr": "x=4",
              "ops": [
                {
                  "rule": "simplify_arithmetic"
                }
              ]
            }
          ]
        },
        {
          "id": "ex-add-sub-2",
          "form": "x-a=b",
          "equation": "x-5=2",
          "solution": "7",
          "purpose": "両辺に同じ数をたす（x－5＝2）",
          "steps": [
            {
              "expr": "x-5=2"
            },
            {
              "expr": "x-5+5=2+5",
              "ops": [
                {
                  "rule": "add_both_sides",
                  "arg": "5"
                }
              ]
            },
            {
              "expr": "x=7",
              "ops": [
                {
                  "rule": "simplify_arithmetic"
                }
              ]
            }
          ]
        }
      ]
    },
    {
